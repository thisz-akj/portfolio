# Copy to assistant/.env (git-ignored). Without GEMINI_API_KEY the assistant runs in offline mode
# (answers by quoting the closest section of the site, clearly labelled).
# Any provider with a key is used; Groq (free tier, fastest) is tried first by default.
GROQ_API_KEY=
GEMINI_API_KEY=
# Tried in order; if one is busy, failing or slow to start, the next answers
ASSISTANT_MODELS=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite
# Seconds to wait for a model to start answering before falling back
ASSISTANT_FIRST_TOKEN_TIMEOUT=5
# minimal | low | medium | high — empty to use the model default
ASSISTANT_THINKING=low
# Free questions per visitor per day (enforced in Next.js) — then a pop-up invites a message
AI_FREE_QUESTIONS=3
# Live answers per day across all visitors (offline mode after that)
ASSISTANT_DAILY_LIMIT=300
# Optional shared secret; when set, Next.js must send it as x-assistant-token
ASSISTANT_TOKEN=
