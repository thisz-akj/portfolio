# Public base URL (used for sitemap, robots, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# --- Contact form delivery -------------------------------------------------
# Email via Resend (https://resend.com → API Keys). Without RESEND_API_KEY and CONTACT_WEBHOOK_URL,
# /api/contact validates the message and the UI falls back to a pre-filled mailto link.
RESEND_API_KEY=
# Inbox that receives enquiries (defaults to site.email in src/content/site.ts).
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend, e.g. "Azad Kumar Jha <hello@yourdomain.com>".
# Left empty, Resend's test sender is used, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
# "true" sends the visitor a confirmation email (requires a verified sending domain).
CONTACT_AUTOREPLY=false
# Optional extra ping (Slack/Discord/Make/Zapier) receiving {"text": "..."} JSON.
CONTACT_WEBHOOK_URL=
# --- Ops Suite demo database ----------------------------------------------
# Required. Local: postgres://ops:ops@localhost:5432/ops_suite (see docs/demos/ops-suite.md).
# Vercel: the Neon *pooled* connection string.
DATABASE_URL=
# Nightly demo reset (Vercel Cron → /api/demos/ops-suite/cron/reset, 03:00 IST). Any long random string;
# Vercel sends it automatically as a Bearer token when set in the project env. Leave empty to disable the endpoint.
CRON_SECRET=
# --- Ops Suite AI ("Ask Ops Suite") ----------------------------------------
# Anthropic API key. Without it, Ask shows hand-written example plans only (clearly labelled).
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5-5, effort low) and a daily question cap for the public demo.
OPS_AI_MODEL=
OPS_AI_EFFORT=
OPS_AI_DAILY_LIMIT=300
