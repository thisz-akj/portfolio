# Copy to deploy/.env on the server (git-ignored). Real secrets only live there and in Vercel.

# HTTPS host Caddy serves. No domain yet? Use <server-ip-with-dashes>.sslip.io, e.g. api.203-0-113-7.sslip.io
API_HOST=

# Shared secrets: the site sends these; requests without them are refused.
# Generate each with: openssl rand -hex 32   (use the same values in Vercel)
ASSISTANT_TOKEN=
DOCINTEL_TOKEN=
VOICE_TOKEN=

# Models (free tier)
GROQ_API_KEY=
GEMINI_API_KEY=

# LiveKit Cloud (voice worker + voice service)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The deployed site; the voice worker calls its /api/assistant and /api/demos/voice-ai/turn
SITE_INTERNAL_URL=https://your-site.vercel.app

# Daily caps (defaults shown)
ASSISTANT_DAILY_LIMIT=300
VOICE_DAILY_LIMIT=300
